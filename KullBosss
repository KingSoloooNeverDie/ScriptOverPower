-- Main Loop Otomasi Bos
task.spawn(function()
    while true do
        task.wait(0.1)
        if not isRunning then continue end

        local _, hrp, hum = getCharacterParts()
        if not hrp or not hum then
            task.wait(1)
            continue
        end

        currentStage = 1
        if _G.ToggleFastPunch then _G.ToggleFastPunch(false) end
        
        -- 1. Aktifkan terbang & emote duluan di lokasi asal
        setBossFlying(true, hrp, hum)
        playBossEmote(hum, emoteIdleName)
        
        task.wait(3)
        if not isRunning then continue end

        -- 2. Teleport & Cari Spot Kosong Instan (Stage 1)
        local selectedWaitCFrame = getOrFindWaitCFrame()

        local activeBossModel = nil

        -- 3. Pencarian Boss MURNI KODE PERTAMA (Workspace:GetDescendants)
        while isRunning do
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if not isRunning then break end
                if obj:IsA("Model") and Players:GetPlayerFromCharacter(obj) == nil then
                    local objNameLower = string.lower(obj.Name)
                    local matched = false
                    
                    for _, keyword in ipairs(SEARCH_KEYWORDS) do
                        if string.find(objNameLower, keyword) then
                            matched = true
                            break
                        end
                    end
                    
                    if matched then
                        local health = obj:GetAttribute("Health")
                        if health == nil or health > 0 then
                            activeBossModel = obj
                            break
                        end
                    end
                end
            end
            
            if activeBossModel or not isRunning then
                break
            end
            
            task.wait(1)
        end

        if not isRunning then continue end

        -- STAGE 2 (MURNI KODE PERTAMA)
        currentStage = 2
        
        setBossFlying(true, hrp, hum)
        playBossEmote(hum, emoteIdleName)
        
        task.wait(2)
        
        if _G.ToggleFastPunch and isRunning then
            _G.ToggleFastPunch(true)
        end
        
        local offsetX, offsetY, offsetZ = 0, 100, 0
        if activeBossModel then
            local activeNameLower = string.lower(activeBossModel.Name)
            if string.find(activeNameLower, "boss1") or string.find(activeNameLower, "boss2") or string.find(activeNameLower, "boss3") then
                offsetX, offsetY, offsetZ = 0, 100, 0
            elseif string.find(activeNameLower, "boss4") or string.find(activeNameLower, "boss5") or string.find(activeNameLower, "bossrainbow") then
                offsetX, offsetY, offsetZ = 0, 145, 0
            end
        end
        
        while isRunning and activeBossModel and activeBossModel.Parent do
            local health = activeBossModel:GetAttribute("Health")
            if health and health <= 0 then
                break
            end
            
            local targetPos = nil
            local root = activeBossModel:FindFirstChild("HumanoidRootPart") or activeBossModel:FindFirstChild("Torso") or activeBossModel:FindFirstChild("Head")
            if root and root:IsA("BasePart") then
                targetPos = root.Position
            else
                local success, modelPos = pcall(function() return activeBossModel:GetPivot().Position end)
                if success and modelPos then targetPos = modelPos end
            end
            
            if targetPos and bossFlyBV and bossFlyBG and hrp then
                local destPos = targetPos + Vector3.new(offsetX, offsetY, offsetZ)
                local dir = (destPos - hrp.Position)
                
                if dir.Magnitude > 3 then
                    bossFlyBV.Velocity = dir.Unit * 180
                else
                    bossFlyBV.Velocity = Vector3.zero
                end
                
                local lookAtPos = Vector3.new(targetPos.X, hrp.Position.Y, targetPos.Z)
                bossFlyBG.CFrame = CFrame.lookAt(hrp.Position, lookAtPos)
            end
            
            pcall(function()
                for _, part in ipairs(activeBossModel:GetDescendants()) do
                    if part:IsA("BasePart") then
                        local _, currentHrp = getCharacterParts()
                        if currentHrp then
                            for _, charPart in ipairs(player.Character:GetDescendants()) do
                                if charPart:IsA("BasePart") then
                                    firetouchinterest(charPart, part, 0)
                                    firetouchinterest(charPart, part, 1)
                                end
                            end
                        end
                    end
                end
            end)
            
            task.wait(0.1)
        end

        -- KETIKA BOS MATI (MURNI KODE PERTAMA)
        if _G.ToggleFastPunch then
            _G.ToggleFastPunch(false)
        end
        
        unequipAllTools()

        setBossFlying(false, hrp, hum)
        task.wait(0.3)

        if not isRunning then continue end

        -- STAGE 3 (MURNI KODE PERTAMA)
        currentStage = 3
        local chestFound = false
        local SEARCH_KEYWORD_CHEST = "chest_base"

        for _, obj in ipairs(Workspace:GetDescendants()) do
            if string.find(string.lower(obj.Name), SEARCH_KEYWORD_CHEST) then
                local targetPos = nil
                if obj:IsA("Model") then
                    local success, pos = pcall(function() return obj:GetPivot().Position end)
                    if success and pos then targetPos = pos end
                elseif obj:IsA("BasePart") then
                    targetPos = obj.Position
                end
                
                if targetPos then
                    local offsetPos = targetPos + Vector3.new(-15, 15, 0)
                    hrp.CFrame = CFrame.lookAt(offsetPos, targetPos)
                    chestFound = true
                    break
                end
            end
        end

        task.wait(0.5)

        -- STAGE 4 (MURNI KODE PERTAMA)
        currentStage = 4
        task.wait(5)
    end
end)
