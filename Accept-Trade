local event = game.ReplicatedStorage.rEvents.tradingEvent
local lp = game.Players.LocalPlayer
local ALLOWED_USERNAME = "Zor_Twin"

event.OnClientEvent:Connect(function(action, fromPlayer)
    if action == "tradeRequest" and fromPlayer ~= lp then
        if fromPlayer.Name == ALLOWED_USERNAME then
            event:FireServer("requestAccepted", fromPlayer)
        end
    end
end)

while true do
    event:FireServer("acceptTrade")
    task.wait(0.4)
end

