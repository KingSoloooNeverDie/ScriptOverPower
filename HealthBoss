local function createShadow(thickness, transparency)
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = thickness
	stroke.Transparency = transparency
	stroke.Color = Color3.fromRGB(0, 0, 0)
	stroke.Parent = mainFrame
	return stroke
end

