local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

-- Variabel Posisi Kamera (Bisa Anda ubah-ubah koordinatnya nanti)
local currentCamPos = Vector3.new(-37052.28, 1401.56, -8025.13) 

local cameraYaw = 0   
local cameraPitch = 0 
local isDragging = false
local lastMousePos = Vector2.new(0, 0)
local freecamConnection = nil
local isCameraActive = false

-- Deklarasi fungsi lebih awal agar bisa dipanggil di tombol
local setStaticCamera, resetCameraToNormal

-- ==========================================
-- 1. FUNGSI UNTUK MENYALAKAN / MEMINDAHKAN KAMERA
-- ==========================================
setStaticCamera = function(newPosition)
    if newPosition then
        currentCamPos = newPosition
    end
    
    isCameraActive = true
    camera.CameraType = Enum.CameraType.Scriptable
    
    if freecamConnection then
        freecamConnection:Disconnect()
    end
    
    freecamConnection = RunService.RenderStepped:Connect(function()
        local rotationCFrame = CFrame.new(currentCamPos) * CFrame.Angles(0, cameraYaw, 0) * CFrame.Angles(cameraPitch, 0, 0)
        camera.CFrame = rotationCFrame
    end)
end

-- ==========================================
-- 2. FUNGSI UNTUK MENGEMBALIKAN KE NORMAL (OFF)
-- ==========================================
resetCameraToNormal = function()
    isCameraActive = false
    
    if freecamConnection then
        freecamConnection:Disconnect()
        freecamConnection = nil
    end
    
    local character = player.Character or player.CharacterAdded:Wait()
    local humanoid = character:WaitForChild("Humanoid", 3)
    
    if humanoid then
        camera.CameraSubject = humanoid
    end
    
    camera.CameraType = Enum.CameraType.Custom
end

-- ==========================================
-- 3. KONTROL GESER LAYAR / MOUSE (ROTASI)
-- ==========================================
UserInputService.InputBegan:Connect(function(input)
    if isCameraActive and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1) then
        isDragging = true
        lastMousePos = input.Position
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        isDragging = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if isCameraActive and isDragging and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.MouseMovement) then
        local delta = input.Position - lastMousePos
        lastMousePos = input.Position
        
        cameraYaw = cameraYaw - delta.X * 0.005
        cameraPitch = math.clamp(cameraPitch - delta.Y * 0.005, -math.pi/2 + 0.01, math.pi/2 - 0.01)
    end
end)

-- ==========================================
-- 4. MEMBUAT UI TOMBOL ON/OFF DI SEBELAH KANAN ATAS
-- ==========================================
for _, gui in ipairs(CoreGui:GetChildren()) do
    if gui.Name == "ToggleCameraControlGui" then
        gui:Destroy()
    end
end
for _, gui in ipairs(player.PlayerGui:GetChildren()) do
    if gui.Name == "ToggleCameraControlGui" then
        gui:Destroy()
    end
end

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "ToggleCameraControlGui"
pcall(function() screenGui.Parent = CoreGui end)
if not screenGui.Parent then
    screenGui.Parent = player:WaitForChild("PlayerGui")
end

local btnToggle = Instance.new("TextButton")
btnToggle.Size = UDim2.new(0, 160, 0, 40)
btnToggle.Position = UDim2.new(1, -170, 0, 50)
btnToggle.BackgroundColor3 = Color3.fromRGB(0, 200, 100) -- Warna Hijau (Awalnya ON)
btnToggle.TextColor3 = Color3.fromRGB(255, 255, 255)
btnToggle.TextSize = 14
btnToggle.Font = Enum.Font.SourceSansBold
btnToggle.Text = "Kamera: ON"
btnToggle.Parent = screenGui
Instance.new("UICorner", btnToggle).CornerRadius = UDim.new(0, 6)

-- Logika Tombol On/Off saat diklik
btnToggle.MouseButton1Click:Connect(function()
    if isCameraActive then
        resetCameraToNormal()
        btnToggle.Text = "Kamera: OFF"
        btnToggle.BackgroundColor3 = Color3.fromRGB(150, 50, 50) -- Warna Merah
    else
        setStaticCamera()
        btnToggle.Text = "Kamera: ON"
        btnToggle.BackgroundColor3 = Color3.fromRGB(0, 200, 100) -- Warna Hijau
    end
end)

-- ==========================================
-- 5. AUTO AKTIF SAAT PERTAMA KALI DIJALANKAN
-- ==========================================
setStaticCamera()
