local function create(class, props, children)
	local inst = Instance.new(class)
	for k, v in pairs(props or {}) do
		inst[k] = v
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	return inst
end

local function tween(obj, t, props, style, dir)
	local tw = TweenService:Create(obj, TweenInfo.new(t, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

-- Efek liquid glass: gradient, garis tepi neon, kilau di atas
local function glass(frame, radius, transparency)
	radius = radius or 20
	frame.BackgroundColor3 = C.White
	frame.BackgroundTransparency = transparency or 0.5
	frame.BorderSizePixel = 0
	create("UICorner", { CornerRadius = UDim.new(0, radius), Parent = frame })
	create("UIGradient", { Rotation = 0, Color = ColorSequence.new(C.GlassA, C.GlassB), Parent = frame })
	local stroke = create("UIStroke", {
		Thickness = 1.5, Color = C.White, Transparency = 0.1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = frame,
	})
	create("UIGradient", {
		Rotation = 0,
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, C.Cyan),
			ColorSequenceKeypoint.new(1, C.Purple),
		}),
		Parent = stroke,
	})
	local gloss = create("Frame", {
		Name = "Gloss", Size = UDim2.new(1, -16, 0.42, 0), Position = UDim2.new(0, 8, 0, 4),
		BackgroundColor3 = C.White, BorderSizePixel = 0, ZIndex = 0, Parent = frame,
	})
	create("UICorner", { CornerRadius = UDim.new(0, math.max(radius - 6, 4)), Parent = gloss })
	create("UIGradient", {
		Rotation = 90,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.8),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = gloss,
	})
	return frame
end

local function label(parent, text, size, pos, textSize, color, font, align)
	return create("TextLabel", {
		Text = text, Size = size, Position = pos, BackgroundTransparency = 1,
		Font = font or Enum.Font.GothamMedium, TextSize = textSize or 14,
		TextColor3 = color or C.Text, TextXAlignment = align or Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 3, Parent = parent,
	})
end

local function hover(btn, base, over)
	btn.MouseEnter:Connect(function() tween(btn, 0.2, { BackgroundTransparency = over }) end)
	btn.MouseLeave:Connect(function() tween(btn, 0.25, { BackgroundTransparency = base }) end)
end

