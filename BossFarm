-- Ikon gear sederhana (tanpa asset / unicode)
local function makeGear(parent, pos)
	local g = create("Frame", {
		Size = UDim2.new(0, 28, 0, 28), Position = pos, BackgroundTransparency = 1, ZIndex = 3, Parent = parent,
	})
	create("Frame", {
		Size = UDim2.new(0, 16, 0, 16), Position = UDim2.new(0.5, -8, 0.5, -8),
		BackgroundTransparency = 1, ZIndex = 3, Parent = g,
	}, {
		create("UICorner", { CornerRadius = UDim.new(1, 0) }),
		create("UIStroke", { Thickness = 2, Color = C.Cyan }),
	})
	create("Frame", {
		Size = UDim2.new(0, 5, 0, 5), Position = UDim2.new(0.5, -2.5, 0.5, -2.5),
		BackgroundColor3 = C.Cyan, BorderSizePixel = 0, ZIndex = 3, Parent = g,
	}, { create("UICorner", { CornerRadius = UDim.new(1, 0) }) })
	for i = 0, 7 do
		local a = math.rad(i * 45)
		local cx, cy = 14 + math.cos(a) * 10.5, 14 + math.sin(a) * 10.5
		create("Frame", {
			Size = UDim2.new(0, 6, 0, 3), Position = UDim2.new(0, cx - 3, 0, cy - 1.5),
			Rotation = i * 45, BackgroundColor3 = C.Cyan, BorderSizePixel = 0, ZIndex = 3, Parent = g,
		})
	end
	return g
end

