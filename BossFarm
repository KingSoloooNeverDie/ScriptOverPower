local bossFlyBV = nil
local bossFlyBG = nil
local emoteIdleName, emoteIdleId = "GodlikeIdle", 81359407734079

local function playBossEmote(hum, name)
	local animator = hum:FindFirstChildOfClass("Animator")
	if not animator then return end
	pcall(function()
		hum:PlayEmote(name)
		task.delay(0.05, function()
			for _, track in pairs(animator:GetPlayingAnimationTracks()) do
				if track.IsPlaying then
					track.Priority = Enum.AnimationPriority.Action4
					track.Looped = true
					track:AdjustSpeed(1)
				end
			end
		end)
	end)
end

local function setBossFlying(enabled, hrp, hum)
	if not hrp or not hum then return end
	local desc = hum:FindFirstChildOfClass("HumanoidDescription")
	if desc then
		pcall(function() desc:SetEmotes({[emoteIdleName] = {emoteIdleId}}) end)
	end
	if enabled then
		wasFlying = true
		hum:SetStateEnabled(Enum.HumanoidStateType.Running, false)
		hum:ChangeState(Enum.HumanoidStateType.Physics)
		if not bossFlyBV or bossFlyBV.Parent ~= hrp then
			bossFlyBV = Instance.new("BodyVelocity")
			bossFlyBV.Name = "BossFlyBV"
			bossFlyBV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
			bossFlyBV.Velocity = Vector3.zero
			bossFlyBV.Parent = hrp
		end
		if not bossFlyBG or bossFlyBG.Parent ~= hrp then
			bossFlyBG = Instance.new("BodyGyro")
			bossFlyBG.Name = "BossFlyBG"
			bossFlyBG.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
			bossFlyBG.P = 5000
			bossFlyBG.Parent = hrp
		end
	else
		if wasFlying then
			wasFlying = false
			if bossFlyBV then bossFlyBV:Destroy() bossFlyBV = nil end
			if bossFlyBG then bossFlyBG:Destroy() bossFlyBG = nil end
			hum:SetStateEnabled(Enum.HumanoidStateType.Running, true)
			hum:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
	end
end

local CHECK_RADIUS = 6

local function isCurrentPositionClear()
	local myHrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not myHrp then return false end
	for _, otherPlayer in ipairs(Players:GetPlayers()) do
		if otherPlayer ~= player and otherPlayer.Character then
			local otherHrp = otherPlayer.Character:FindFirstChild("HumanoidRootPart")
			if otherHrp then
				local distance = (otherHrp.Position - myHrp.Position).Magnitude
				if distance <= CHECK_RADIUS then
					return false
				end
			end
		end
	end
	return true
end

local function getOrFindWaitCFrame(positionsTable, currentSaved)
	local character = player.Character or player.CharacterAdded:Wait()
	local hrp = character:WaitForChild("HumanoidRootPart")

	if currentSaved then
		hrp.CFrame = currentSaved
		if bossFlyBG then bossFlyBG.CFrame = currentSaved end
		if isCurrentPositionClear() then
			return currentSaved, currentSaved
		else
			currentSaved = nil
		end
	end

	for _, candidateCFrame in ipairs(positionsTable) do
		hrp.CFrame = candidateCFrame
		if bossFlyBG then bossFlyBG.CFrame = candidateCFrame end
		if isCurrentPositionClear() then
			return candidateCFrame, candidateCFrame
		end
	end

	local fallback = positionsTable[1]
	hrp.CFrame = fallback
	if bossFlyBG then bossFlyBG.CFrame = fallback end
	return fallback, fallback
end

local function findBossByKeywords(keywords)
	if #keywords == 0 then return nil end
	for _, obj in ipairs(Workspace:GetDescendants()) do
		if not active() then break end
		if obj:IsA("Model") and Players:GetPlayerFromCharacter(obj) == nil then
			local objNameLower = string.lower(obj.Name)
			local matched = false
			for _, keyword in ipairs(keywords) do
				if string.find(objNameLower, string.lower(keyword)) then
					matched = true
					break
				end
			end
			if matched then
				local health = obj:GetAttribute("Health")
				if health == nil or health > 0 then
					return obj
				end
			end
		end
	end
	return nil
end

