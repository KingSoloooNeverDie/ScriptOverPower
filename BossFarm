-- LOOP UTAMA: OTOMASI BOSS
--------------------------------------------------------------------
local function gotoWaitZone(zone)
	S.zone = zone
	if zone == "alien" then
		local _, saved = getOrFindWaitCFrame(ALIEN_WAIT_POSITIONS, savedAlienWaitCFrame)
		savedAlienWaitCFrame = saved
		setStage("menunggu Alien Boss")
	else
		local _, saved = getOrFindWaitCFrame(MAIN_WAIT_POSITIONS, savedMainWaitCFrame)
		savedMainWaitCFrame = saved
		setStage("menunggu boss")
	end
end

task.spawn(function()
	while S.alive do
		task.wait(0.1)
		if not active() then continue end

		-- Ambil karakter TERBARU di awal tiap siklus.
		-- Kalau mati, tunggu respawn lalu mulai siklus baru.
		local _, hrp, hum = getCharacterParts()
		if not charAlive(hrp, hum) then
			waitRespawn()
			continue
		end

		if #getMainKeywords() == 0 and not alienEnabled() then
			setStage("pilih boss dulu di Boss List")
			task.wait(1)
			continue
		end

		-- STAGE 1: menunggu boss
		S.stage = 1
		setStage("menunggu boss")
		if _G.ToggleFastPunch then _G.ToggleFastPunch(false) end

		setBossFlying(true, hrp, hum)
		playBossEmote(hum, emoteIdleName)
		task.wait(3)
		if not active() or not charAlive(hrp, hum) then continue end

		gotoWaitZone(#getMainKeywords() == 0 and "alien" or "main")

		local activeBossModel = nil
		local isAlienTarget = false
		local waitStartTime = os.clock()

		while active() and charAlive(hrp, hum) do
			local mainKw = getMainKeywords()
			local alienOn = alienEnabled()

			local mainBoss = findBossByKeywords(mainKw)
			if mainBoss then
				activeBossModel = mainBoss
				isAlienTarget = false
				break
			end

			if #mainKw == 0 and not alienOn then
				setStage("pilih boss dulu di Boss List")
			elseif S.zone == "main" and alienOn then
				if #mainKw == 0 then
					gotoWaitZone("alien")
				elseif S.alienFallback then
					local left = math.max(0, S.waitTimeout - (os.clock() - waitStartTime))
					setStage(string.format("menunggu boss (Alien dalam %ds)", math.ceil(left)))
					if left <= 0 then
						gotoWaitZone("alien")
					end
				end
			end

			if S.zone == "alien" and alienOn then
				local alienBoss = findBossByKeywords(ALIEN_BOSS_KEYWORDS)
				if alienBoss then
					activeBossModel = alienBoss
					isAlienTarget = true
					break
				end
			end

			task.wait(0.5)
		end

		-- Mati / dimatikan saat menunggu -> balik ke awal siklus
		if not active() or not charAlive(hrp, hum) or not activeBossModel then continue end

		-- STAGE 2: serang boss
		S.stage = 2
		local bossName = activeBossModel.Name
		setStage("menyerang " .. bossName)
		setBossFlying(true, hrp, hum)
		playBossEmote(hum, emoteIdleName)
		task.wait(2)
		if S.fastPunch and active() and charAlive(hrp, hum) and _G.ToggleFastPunch then _G.ToggleFastPunch(true) end

		local offsetX, offsetY, offsetZ = 0, 100, 0
		local activeNameLower = string.lower(bossName)
		if string.find(activeNameLower, "boss1") or string.find(activeNameLower, "boss2") or string.find(activeNameLower, "boss3") then
			offsetX, offsetY, offsetZ = 0, 100, 0
		elseif string.find(activeNameLower, "boss4") or string.find(activeNameLower, "boss5") or string.find(activeNameLower, "bossrainbow") then
			offsetX, offsetY, offsetZ = 0, 145, 0
		elseif isAlienTarget then
			offsetX, offsetY, offsetZ = 0, 30, 0 -- khusus Alien Boss
		end

		local interruptedByMainBoss = false
		local maxSeen = 1
		local bossDied = false

		while active() and activeBossModel and activeBossModel.Parent and charAlive(hrp, hum) do
			local health = activeBossModel:GetAttribute("Health")
			if health then
				maxSeen = math.max(maxSeen, health)
				barLabel.Text = string.format("%s   %d / %d", bossName, math.floor(health), math.floor(maxSeen))
				tween(hpFill, 0.15, { Size = UDim2.new(math.clamp(health / maxSeen, 0, 1), 0, 1, 0) })
				if health <= 0 then
					bossDied = true
					break
				end
			else
				barLabel.Text = bossName .. "   HP ?"
			end

			if isAlienTarget then
				local mk = getMainKeywords()
				if #mk > 0 and findBossByKeywords(mk) then
					interruptedByMainBoss = true
					break
				end
			end

			local targetPos2 = nil
			local rootPart = activeBossModel:FindFirstChild("HumanoidRootPart") or activeBossModel:FindFirstChild("Torso") or activeBossModel:FindFirstChild("Head")
			if rootPart and rootPart:IsA("BasePart") then
				targetPos2 = rootPart.Position
			else
				local success, modelPos = pcall(function() return activeBossModel:GetPivot().Position end)
				if success and modelPos then
					targetPos2 = modelPos
				end
			end

			if targetPos2 and bossFlyBV and bossFlyBG and hrp then
				local destPos = targetPos2 + Vector3.new(offsetX, offsetY, offsetZ)
				local dir = (destPos - hrp.Position)
				if dir.Magnitude > 3 then
					bossFlyBV.Velocity = dir.Unit * 180
				else
					bossFlyBV.Velocity = Vector3.zero
				end
				local lookAtPos = Vector3.new(targetPos2.X, hrp.Position.Y, targetPos2.Z)
				bossFlyBG.CFrame = CFrame.lookAt(hrp.Position, lookAtPos)
			end

			pcall(function()
				local char = player.Character
				if not char then return end
				local charParts = {}
				for _, charPart in ipairs(char:GetDescendants()) do
					if charPart:IsA("BasePart") then
						table.insert(charParts, charPart)
					end
				end
				for _, part in ipairs(activeBossModel:GetDescendants()) do
					if part:IsA("BasePart") then
						for _, charPart in ipairs(charParts) do
							firetouchinterest(charPart, part, 0)
							firetouchinterest(charPart, part, 1)
						end
					end
				end
			end)

			task.wait(0.1)
		end

		-- Karakter mati saat menyerang -> balik ke awal siklus (tunggu respawn)
		if active() and not charAlive(hrp, hum) then
			if bossDied then
				S.kills += 1
				notify(bossName .. " terbunuh!  (total " .. S.kills .. ")", C.Ok)
			end
			continue
		end

		if interruptedByMainBoss then
			if _G.ToggleFastPunch then _G.ToggleFastPunch(false) end
			tween(hpFill, 0.3, { Size = UDim2.new(0, 0, 1, 0) })
			gotoWaitZone("main")
			continue
		end

		-- Boss mati / loop berhenti
		if active() and (bossDied or not activeBossModel.Parent) then
			S.kills += 1
			notify(bossName .. " terbunuh!  (total " .. S.kills .. ")", C.Ok)
		end
		tween(hpFill, 0.3, { Size = UDim2.new(0, 0, 1, 0) })
		if _G.ToggleFastPunch then _G.ToggleFastPunch(false) end
		unequipAllTools()
		setBossFlying(false, hrp, hum)
		task.wait(0.3)
		if not active() or not charAlive(hrp, hum) then continue end

		-- STAGE 3: teleport ke peti
		S.stage = 3
		setStage("menuju peti")
		S.chestKey = isAlienTarget and "alien chest" or "bosschest"
		local chestOffset = isAlienTarget and Vector3.new(-15, 4, 0) or Vector3.new(-15, 15, 0)
		local SEARCH_KEYWORD_CHEST = isAlienTarget and "alien chest" or "chest_base"
		for _, obj in ipairs(Workspace:GetDescendants()) do
			if string.find(string.lower(obj.Name), SEARCH_KEYWORD_CHEST, 1, true) then
				local chestPos = nil
				if obj:IsA("Model") then
					local success, pos = pcall(function() return obj:GetPivot().Position end)
					if success and pos then chestPos = pos end
				elseif obj:IsA("BasePart") then
					chestPos = obj.Position
				end
				if chestPos then
					local offsetPos = chestPos + chestOffset
					hrp.CFrame = CFrame.lookAt(offsetPos, chestPos)
					break
				end
			end
		end
		task.wait(0.5)

		-- STAGE 4: klaim peti
		S.stage = 4
		setStage("klaim peti")
		task.wait(5)
	end
end)

