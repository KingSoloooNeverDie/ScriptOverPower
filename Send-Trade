local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer
local tradingEvent = ReplicatedStorage:FindFirstChild("rEvents") and ReplicatedStorage.rEvents:FindFirstChild("tradingEvent") 

local targetPlayerName = "Zor_Twin"             
local autoTradeActive = true                 

local function isTradePending()
    return player:FindFirstChild("CurrentTrade") ~= nil
end

local function mainTradeLoop()
    while true do
        if autoTradeActive and tradingEvent then
            local selectedPlayer = Players:FindFirstChild(targetPlayerName)
            
            if selectedPlayer and not isTradePending() then
                pcall(function() 
                    tradingEvent:FireServer("sendTradeRequest", selectedPlayer) 
                end)
            end
        end
        
        task.wait(0.1)
    end
end

task.spawn(mainTradeLoop)

