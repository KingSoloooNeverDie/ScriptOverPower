local function InitialHideAll()
    if not petsFolder then return end
    for _, folder in ipairs(petsFolder:GetChildren()) do
        if folder:IsA("Folder") then
            for _, pet in ipairs(folder:GetChildren()) do
                petOriginTable[pet] = folder
                pet.Parent = hiddenStorage
            end
        end
    end
end
InitialHideAll()

-- PERUBAHAN: Hanya mengambil SATU jenis pet pertama yang tersedia dari daftar centang (Sistem Antrian)
local function getNextAvailablePetInstances(petNamesTable, n)
    local pets = {}
    if not petsFolder then return pets end 

    for _, petName in ipairs(petNamesTable) do
        local currentPetsOfType = {}
        for _, folder in ipairs(petsFolder:GetChildren()) do
            if folder:IsA("Folder") then
                for _, pet in ipairs(folder:GetChildren()) do
                    if pet.Name == petName then
                        table.insert(currentPetsOfType, pet)
                        if #currentPetsOfType >= n then break end
                    end
                end
            end
        end
        
        -- Jika jenis pet ini ditemukan dan ada isinya, ambil ini saja lalu langsung kembalikan (Antrian pertama)
        if #currentPetsOfType > 0 then
            return currentPetsOfType
        end
    end
    
    return pets
end

local function isTradePending()
    return LocalPlayer:FindFirstChild("CurrentTrade") ~= nil
end

local function isTradeAccepted()
    local currentTrade = LocalPlayer:FindFirstChild("CurrentTrade")
    if currentTrade and currentTrade:FindFirstChild("Accepted") then
        return currentTrade.Accepted.Value
    end
    return false
end

local function initializeTargetPlayer()
    selectedPlayer = Players:FindFirstChild(targetPlayerName) 
    if not selectedPlayer then
        warn("Target Player '" .. targetPlayerName .. "' tidak ditemukan di server.")
    end
end
initializeTargetPlayer()

local function runExecution()
    if not petsFolder or #selectedPets == 0 then return false end
    
    local allPets = {}
    for _, folder in ipairs(petsFolder:GetChildren()) do
        if folder:IsA("Folder") then
            for _, pet in ipairs(folder:GetChildren()) do
                petOriginTable[pet] = folder
                table.insert(allPets, pet)
            end
        end
    end
    for _, pet in ipairs(hiddenStorage:GetChildren()) do 
        table.insert(allPets, pet) 
    end
    
    local count = 0
    for _, pet in ipairs(allPets) do
        local isSelected = false
        for _, name in ipairs(selectedPets) do
            if pet.Name == name then
                isSelected = true
                break
            end
        end
        
        if isSelected and count < amount then
            pet.Parent = petOriginTable[pet] or petsFolder:FindFirstChildWhichIsA("Folder")
            count = count + 1
        else
            pet.Parent = hiddenStorage
        end
    end
    return true, count
end

