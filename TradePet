task.spawn(function()
    print("Auto-Trade Script Active (Queue Mode)")
    while true do
        if autoTradeActive and #selectedPets > 0 and selectedPlayer and not isTradePending() and tradingEvent then
            -- Mengambil pet berdasarkan antrian (urutan centang)
            local pets = getNextAvailablePetInstances(selectedPets, PET_COUNT)
            if #pets > 0 then
                pcall(function() tradingEvent:FireServer("sendTradeRequest", selectedPlayer) end)
                task.wait(0.1)
                
                for _, pet in ipairs(pets) do
                    if pet and pet.Parent then
                        pcall(function() tradingEvent:FireServer("offerItem", pet) end)
                        task.wait(0.01)
                    end
                end
                
                if not isTradeAccepted() then 
                    pcall(function() tradingEvent:FireServer("confirmTrade") end)
                    pcall(function() tradingEvent:FireServer("acceptTrade") end)
                end
            end
        end

        if autoTradeActive then
            local currentTrade = LocalPlayer:FindFirstChild("CurrentTrade")
            if currentTrade and tradingEvent then
                pcall(function() tradingEvent:FireServer("acceptTrade") end) 
                task.wait(0.01)

                local tradeItems
                local timeoutStart = tick()
                repeat
                    task.wait(0.01)
                    tradeItems = currentTrade:FindFirstChild("OfferedItems")
                    if tick() - timeoutStart > 5 then break end
                until tradeItems and #tradeItems:GetChildren() > 0

                pcall(function() tradingEvent:FireServer("confirmTrade") end)
                pcall(function() tradingEvent:FireServer("acceptTrade") end)
            end
        end

        task.wait(0.01)
    end
end)
